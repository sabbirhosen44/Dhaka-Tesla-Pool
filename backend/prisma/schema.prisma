datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String        @id @default(uuid())
  name           String
  phone          String        @unique
  role           String        // "PASSENGER" | "DRIVER" | "ADMIN"
  walletBalanceP Int           @default(50000) // Stored in poysha (500 BDT)
  createdAt      DateTime      @default(now())

  vehicles       Vehicle[]
  rideRequests   RideRequest[]
  pools          Pool[]
}

model Vehicle {
  id        String   @id @default(uuid())
  driverId  String
  model     String   @default("Bullet")
  capacity  Int      @default(3) // 3-seat capacity
  isOnline  Boolean  @default(true)
  createdAt DateTime @default(now())

  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  pools     Pool[]
}

model RideRequest {
  id             String         @id @default(uuid())
  passengerId    String
  pickupZone     String         // e.g. "Banani"
  dropoffZone    String         // e.g. "Mohakhali", "Gulshan 1"
  seatsRequested Int            @default(1)
  status         String         @default("REQUESTED") // REQUESTED, MATCHED, DRIVER_ARRIVED, STARTED, COMPLETED, CANCELLED
  createdAt      DateTime       @default(now())

  passenger      User           @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  poolMember     PoolMember?
  eventLogs      RideEventLog[]
}

model Pool {
  id            String       @id @default(uuid())
  driverId      String
  vehicleId     String
  capacity      Int          @default(3)
  occupiedSeats Int          @default(0)
  status        String       @default("OPEN") // OPEN, FULL, ACTIVE, COMPLETED, CANCELLED
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  driver        User         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  poolMembers   PoolMember[]
}

model PoolMember {
  id             String      @id @default(uuid())
  poolId         String
  rideRequestId  String      @unique
  seatsAllocated Int         @default(1)
  baseFare       Int         // In poysha
  distanceFare   Int         // In poysha
  discount       Int         // In poysha
  finalFare      Int         // In poysha
  paymentMethod  String      @default("CASH") // "CASH" | "TESLA_PAY"
  paymentStatus  String      @default("PENDING") // "PENDING" | "PAID"
  joinedAt       DateTime    @default(now())

  pool           Pool        @relation(fields: [poolId], references: [id], onDelete: Cascade)
  rideRequest    RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
}

model RideEventLog {
  id            String      @id @default(uuid())
  rideRequestId String
  fromStatus    String
  toStatus      String
  note          String?
  timestamp     DateTime    @default(now())

  rideRequest   RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
}
